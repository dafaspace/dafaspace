#!/bin/sh
# dafaspace: no commit with a translation behind its English (CLAUDE.md, Languages).
# Installed with: git config core.hooksPath tools/hooks
# It checks what is staged, not the working tree, so another session's unstaged edits do not count.
tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT
git checkout-index -a --prefix="$tmp/" || exit 1
[ -f "$tmp/tools/i18n.mjs" ] || exit 0
node "$tmp/tools/i18n.mjs" gate
